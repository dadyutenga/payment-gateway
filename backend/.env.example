# Copy this to .env and fill in your own values. Nothing here is shared
# with anyone else's production system. Bring your own PostgreSQL database.

# ---- Required ----

# PostgreSQL connection string. Migrations create the `app` schema.
DATABASE_URL=postgresql://postgres:password@localhost:5432/payments_gateway?sslmode=disable

# Secret for locally-issued HS256 access tokens. Use 32+ random characters.
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_TOKEN_TTL=24h

# Admin-space sessions (Option A): separate token audience (aud=admin),
# shorter lifetime, stricter login rate limit, ideally a DISTINCT signing
# key so a leaked customer secret cannot mint admin tokens. When
# AUTH_ADMIN_JWT_SECRET is empty the customer secret is reused — audience
# validation still rejects cross-use either way.
# AUTH_ADMIN_JWT_SECRET=replace-with-a-second-long-random-secret-at-least-32-characters
# AUTH_ADMIN_TOKEN_TTL=4h
# AUTH_LOGIN_RATE_LIMIT_PER_MIN=20
# AUTH_ADMIN_LOGIN_RATE_LIMIT_PER_MIN=5

# Base64-encoded 32-byte AES-256 key, used to encrypt payment provider
# credentials (SonicPesa, etc.) at rest. Generate one with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Cloudflare R2 object storage. KYC and support objects remain private;
# branding objects use the separate public/branding prefix and short-lived
# presigned URLs unless R2_PUBLIC_BASE_URL is configured.
R2_ACCOUNT_ID=c2916e0e9a0054b895148724807d1e44
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=docs89
# Leave empty to derive https://R2_ACCOUNT_ID.r2.cloudflarestorage.com.
R2_ENDPOINT=
# Optional custom domain for public branding objects only.
R2_PUBLIC_BASE_URL=

# Merchant self-registration switch. Default true (recommended for
# merchant self-service): anyone may register, but registration ONLY ever
# creates customer accounts — never admins. Create admins with:
#   go run ./cmd/seed-admin -email admin@example.com
# Set AUTH_ALLOW_PUBLIC_REGISTER=false to close signup entirely.
# AUTH_ALLOW_PUBLIC_REGISTER=true
# Analytics payer-hash key (HMAC for repeat-customer metrics). Empty falls
# back to the delivery signing secret — set a distinct value in production.
# ANALYTICS_PAYER_SECRET=
# Email-verification gate (default true — keep it). Only set false as a
# TEMPORARY local-dev escape hatch while no mail provider is wired.
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ---- Recommended ----

APP_ENV=production
APP_PORT=8080
# Frontend origin(s) allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=https://your-payments-frontend.example.com

# HMAC secret used to sign outgoing webhook deliveries to merchant apps
# (X-LipaGO-Signature header). Required (and enforced) once APP_ENV=production.
PAYMENTS_DELIVERY_SIGNING_SECRET=

# The public URL this API is reachable at — used in a couple of places
# for constructing absolute URLs. Set it to wherever you deploy this.
PAYMENTS_PUBLIC_BASE_URL=https://your-payments-api.example.com

# ---- Optional — safe to leave at their defaults ----

# LOG_LEVEL=INFO
# DATABASE_MAX_OPEN_CONNS=20
# DATABASE_MIN_OPEN_CONNS=2
# HTTP_REQUEST_TIMEOUT=15s
# PAYMENTS_WEBHOOK_MAX_BODY_BYTES=1048576
# PAYMENTS_DELIVERY_MAX_ATTEMPTS=10
# PAYMENTS_DELIVERY_BATCH_SIZE=25
# PAYMENTS_DELIVERY_POLL_INTERVAL=30s
# PAYMENTS_RECONCILIATION_STALE_AFTER=15m
# PAYMENTS_RECONCILIATION_BATCH_SIZE=50
# PAYMENTS_RECONCILIATION_INTERVAL=5m

# Pending-order time-to-live stamped as expires_at at creation. The expiry
# worker transitions overdue pending rows to expired (no money moves) and
# emits payment.expired webhooks.
# PAYMENTS_ORDER_TTL=30m
# PAYMENTS_EXPIRY_INTERVAL=1m

# Live-mode guardrails for KYC-verified organizations (sandbox orders skip
# both). Amounts are in the order's currency, numeric strings.
# PAYMENTS_LIVE_MAX_TXN_AMOUNT=5000000
# PAYMENTS_LIVE_DAILY_VOLUME_CAP=50000000

# Stricter default tiers for creator accounts (Part 5 risk posture):
# applied when a creator org has no admin-set override. Admin per-org
# overrides still win for either kind.
# PAYMENTS_CREATOR_LIVE_MAX_TXN_AMOUNT=1000000
# PAYMENTS_CREATOR_LIVE_DAILY_VOLUME_CAP=10000000

# Automated payouts (auto-disbursing an approved withdrawal to the
# provider) default OFF — the SonicPesa disbursement endpoints are
# unverified guesses, so verify the payout provider's disbursement API
# against your own account before turning this on. While off, both
# auto-dispatch and the admin retry-payout endpoint refuse with a
# payouts_disabled error. Until then, mark withdrawals paid manually
# after sending the money yourself.
# PAYMENTS_AUTOMATED_PAYOUTS_ENABLED=false
# PAYMENTS_PAYOUT_PROVIDER=sonicpesa
